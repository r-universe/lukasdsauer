[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "baskoptr"]
	path = baskoptr
	url = https://github.com/lukasdsauer/baskoptr
[submodule "baskwrap"]
	path = baskwrap
	url = https://github.com/lukasdsauer/baskwrap
[submodule "optimizr"]
	path = optimizr
	url = https://github.com/lukasdsauer/optimizr
